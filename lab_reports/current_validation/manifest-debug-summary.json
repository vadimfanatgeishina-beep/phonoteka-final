{
  "variant": "debug",
  "package": "com.phonoteka.labcheck",
  "allowBackup": "false",
  "usesCleartextTraffic": "false",
  "networkSecurityConfig": "@xml/network_security_config",
  "debuggable": "true",
  "components": [
    {
      "kind": "activity",
      "name": "com.phonoteka.MainActivity",
      "exported": "true",
      "permission": null
    },
    {
      "kind": "activity",
      "name": "com.phonoteka.InviteActivity",
      "exported": "false",
      "permission": null
    },
    {
      "kind": "activity",
      "name": "androidx.compose.ui.tooling.PreviewActivity",
      "exported": "true",
      "permission": null
    },
    {
      "kind": "activity",
      "name": "androidx.activity.ComponentActivity",
      "exported": "true",
      "permission": null
    },
    {
      "kind": "service",
      "name": "com.phonoteka.player.PlaybackService",
      "exported": "false",
      "permission": null
    },
    {
      "kind": "service",
      "name": "androidx.camera.core.impl.MetadataHolderService",
      "exported": "false",
      "permission": null
    },
    {
      "kind": "service",
      "name": "androidx.room.MultiInstanceInvalidationService",
      "exported": "false",
      "permission": null
    },
    {
      "kind": "receiver",
      "name": "androidx.profileinstaller.ProfileInstallReceiver",
      "exported": "true",
      "permission": "android.permission.DUMP"
    },
    {
      "kind": "provider",
      "name": "androidx.startup.InitializationProvider",
      "exported": "false",
      "permission": null
    }
  ]
}
